# OPEA service configuration
REGISTRY=opea
TAG=latest
INDEX_NAME=rag-redis
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
RERANK_MODEL_ID=BAAI/bge-reranker-base
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
TEI_EMBEDDING_ENDPOINT=http://tei-embedding-service:80
EMBEDDING_SERVER_PORT=80
RERANK_SERVER_PORT=80
LLM_SERVER_PORT=8000
LOGFLAG=false

# Public model downloads do not normally need a token.
# Add a Hugging Face token here only if your selected models require it.
HF_TOKEN=

# Proxy settings (leave blank when not required)
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,redis-vector-db,tei-embedding-service,retriever,dataprep-redis-service,chaqna-backend-server,rag-llm,opea-openwebui-adapter

# Existing OPEA UI/Nginx settings; those services will be optional.
NGINX_PORT=8088
BACKEND_SERVICE_ENDPOINT=http://chaqna-backend-server:8888/v1/chatqna
BACKEND_SERVICE_IP=chaqna-backend-server
BACKEND_SERVICE_NAME=chaqna-backend-server
BACKEND_SERVICE_PORT=8888
FRONTEND_SERVICE_IP=chaqna-ui-server
FRONTEND_SERVICE_PORT=5173
DATAPREP_SERVICE_ENDPOINT=http://dataprep-redis-service:5000/v1/dataprep/ingest
DATAPREP_GET_FILE_ENDPOINT=http://dataprep-redis-service:5000/v1/dataprep/get
DATAPREP_DELETE_FILE_ENDPOINT=http://dataprep-redis-service:5000/v1/dataprep/delete
MEGA_SERVICE_HOST_IP=chaqna-backend-server
RETRIEVER_SERVICE_HOST_IP=retriever
